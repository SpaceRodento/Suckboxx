/*=====================================================================
  secrets.h.example — template for local secrets.h

  Copy this to secrets.h and fill in real values. secrets.h is
  gitignored — never commit it.

  Included automatically by config.h if present.
=====================================================================*/

#ifndef SECRETS_H
#define SECRETS_H

// OTA firmware update credentials.
// HTTP Basic Auth at http://<device-ip>/update
#define OTA_USERNAME              "admin"
#define OTA_PASSWORD              "change_me"

// Optional: override default WiFi STA credentials (otherwise set via portal).
// Kun nama on asetettu + WIFI_STA_AUTOCONNECT_DEFAULT=true, laite yhdistaa
// kotiverkkoon automaattisesti bootissa ilman portaalia. Hyodyllinen kun
// LittleFS tyhjennetaan flashilla (pio run -t erase).
// #define WIFI_STA_SSID_DEFAULT        "MyNetwork"
// #define WIFI_STA_PASSWORD_DEFAULT    "mypassword"
// #define WIFI_STA_AUTOCONNECT_DEFAULT true

// Dev-tila: AP + STA pysyvat ikuisesti pystyssa boottauksesta lahtien.
// Otetaan kayttoon kun halutaan pitka wireless_log -monitorointisessio
// (scripts/wireless_log_listener.py). Tuotantokaytossa kommentoituna
// jotta AP sammuu 15 min jalkeen eika naapurit nae "PlantMeister"-verkkoa.
// #define WIFI_PORTAL_NO_TIMEOUT       true

#endif // SECRETS_H
